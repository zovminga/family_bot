# Copy to .env and fill in. Never commit .env.
#
# Isolation model: each household runs their own bot deploy with their own
# BOT_TOKEN + Google Sheet + ALLOWED_USERS. Your sheet never mixes with others.

# From @BotFather
BOT_TOKEN=

# Service account JSON (relative to this repo or absolute)
GOOGLE_CREDS_PATH=secrets/creds.json

# Exact title of the Google Spreadsheet (File → Share with the service account)
SHEET_NAME=FamilyExpenses

# Who may use THIS bot instance. Comma-separated telegram_id:Name
# Get your id with /whoami after the bot is running.
# Example: ALLOWED_USERS=111111111:Ann,222222222:Bob
ALLOWED_USERS=

# Base currency, ISO code. The bot writes it when a voice/receipt/typed
# expense names no currency; the dashboard converts every amount into it.
# One of: RUB RSD EUR JPY GBP USD CNY. Default: EUR. Set it on Render too.
# BASE_CURRENCY=EUR

# Optional — log level of the bot, the dashboard build and scripts:
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO. Tokens and API keys
# are masked in every log line.
# LOG_LEVEL=INFO

# Optional — family time zone (IANA name). "Today", "Yesterday" and the date
# given to voice/receipt parsing follow this zone, not the server clock.
# TZ_NAME=Europe/Belgrade

# Optional — voice / receipt photo parsing
# ANTHROPIC_API_KEY=
# Claude API model id. Default in code is claude-sonnet-5 (legacy; still valid).
# VX_LLM_MODEL=claude-sonnet-5-5
# PX_LLM_MODEL=claude-sonnet-5-5

# Optional — Render webhook (omit for local polling)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# Webhook secret: Telegram sends it with every update, other requests get 403.
# 1-256 chars of A-Z a-z 0-9 _ -. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset in webhook mode, the bot makes a random one at each start.
# WEBHOOK_SECRET=

# Optional — chat id for the dashboard publish from your laptop (see
# dashboard/README.md) and for the bot's summary of last month on the 1st.
# Unset: no summary, and the bot prints one setup line. Set it on Render too.
# DASHBOARD_CHAT_ID=
# Hour (0-23, TZ_NAME) when the summary is sent on the 1st. Default: 9.
# MONTHLY_SUMMARY_HOUR=9
# Hide months before this one (YYYY-MM). Default: show all history.
# DASHBOARD_FROM_MONTH=2024-01
# One Spender under several spellings: alias=Name, comma-separated.
# Default: names are shown as written in the sheet.
# DASHBOARD_SPENDER_ALIASES=ann=Анна,annie=Анна
# Your own shops and places for comment themes go to dashboard/theme_keywords.json
# (git-ignored), see dashboard/README.md.
# Name of the monthly launchd agent (dashboard/schedule.sh), no quotes.
# Default: local.family-bot.dashboard.
# LAUNCHD_LABEL=local.family-bot.dashboard
