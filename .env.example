# Copy to .env and fill in. Never commit .env.
#
# Isolation model: each household runs their own bot deploy with their own
# BOT_TOKEN + Google Sheet + ALLOWED_USERS. Your sheet never mixes with others.

# From @BotFather
BOT_TOKEN=

# Service account JSON (relative to this repo or absolute)
GOOGLE_CREDS_PATH=secrets/creds.json

# Exact title of the Google Spreadsheet (File → Share with the service account)
SHEET_NAME=FamilyExpenses

# Who may use THIS bot instance. Comma-separated telegram_id:Name
# Get your id with /whoami after the bot is running.
# Example: ALLOWED_USERS=111111111:Azat,222222222:Lisa
ALLOWED_USERS=

# Optional — family time zone (IANA name). "Today", "Yesterday" and the date
# given to voice/receipt parsing follow this zone, not the server clock.
# TZ_NAME=Europe/Belgrade

# Optional — voice / receipt photo parsing
# ANTHROPIC_API_KEY=
# Claude API model id. Default in code is claude-sonnet-5 (legacy; still valid).
# VX_LLM_MODEL=claude-sonnet-5-5
# PX_LLM_MODEL=claude-sonnet-5-5

# Optional — Render webhook (omit for local polling)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# Webhook secret: Telegram sends it with every update, other requests get 403.
# 1-256 chars of A-Z a-z 0-9 _ -. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset in webhook mode, the bot makes a random one at each start.
# WEBHOOK_SECRET=

# Optional — dashboard publish from your laptop (see dashboard/README.md)
# DASHBOARD_CHAT_ID=
